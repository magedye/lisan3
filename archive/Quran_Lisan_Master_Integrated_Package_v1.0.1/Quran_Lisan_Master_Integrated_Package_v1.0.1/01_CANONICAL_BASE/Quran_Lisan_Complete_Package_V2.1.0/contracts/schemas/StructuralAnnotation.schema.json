{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "annotation_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Annotation Id",
      "type": "string"
    },
    "occurrence_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Occurrence Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "root": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root"
    },
    "lemma": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lemma"
    },
    "form_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Form Label"
    },
    "pos": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pos"
    },
    "segmentation": {
      "items": {
        "type": "string"
      },
      "title": "Segmentation",
      "type": "array"
    },
    "syntactic_relations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Syntactic Relations",
      "type": "array"
    },
    "ambiguity_notes": {
      "items": {
        "type": "string"
      },
      "title": "Ambiguity Notes",
      "type": "array"
    },
    "review_status": {
      "default": "UNREVIEWED",
      "title": "Review Status",
      "type": "string"
    },
    "fixture_only": {
      "default": false,
      "title": "Fixture Only",
      "type": "boolean"
    }
  },
  "required": [
    "annotation_id",
    "occurrence_id",
    "source_id"
  ],
  "title": "StructuralAnnotation",
  "type": "object"
}
