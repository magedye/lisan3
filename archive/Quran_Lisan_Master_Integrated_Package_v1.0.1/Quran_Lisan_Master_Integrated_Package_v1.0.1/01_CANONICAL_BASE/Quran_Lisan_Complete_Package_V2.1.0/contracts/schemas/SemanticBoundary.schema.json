{
  "$defs": {
    "BoundaryCategory": {
      "enum": [
        "REQUIRED",
        "PERMITTED",
        "EXCLUDED",
        "UNKNOWN",
        "LOCAL_REALIZATION"
      ],
      "title": "BoundaryCategory",
      "type": "string"
    },
    "ClaimEstablishment": {
      "enum": [
        "ESTABLISHED",
        "SUPPORTED",
        "TENTATIVE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "ClaimEstablishment",
      "type": "string"
    },
    "SemanticBoundaryItem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Record Revision",
          "type": "integer"
        },
        "supersedes_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Id"
        },
        "boundary_item_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "title": "Boundary Item Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/BoundaryCategory"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "evidence_relation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
            "type": "string"
          },
          "title": "Evidence Relation Ids",
          "type": "array"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "establishment": {
          "$ref": "#/$defs/ClaimEstablishment",
          "default": "UNKNOWN"
        }
      },
      "required": [
        "boundary_item_id",
        "category",
        "statement",
        "scope"
      ],
      "title": "SemanticBoundaryItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "boundary_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Boundary Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SemanticBoundaryItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "boundary_id",
    "run_id",
    "target_id",
    "items"
  ],
  "title": "SemanticBoundary",
  "type": "object"
}
