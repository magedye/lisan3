{
  "$defs": {
    "BlockerSeverity": {
      "enum": [
        "BLOCKING",
        "DEGRADING",
        "WARNING"
      ],
      "title": "BlockerSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "blocker_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Blocker Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/BlockerSeverity"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "affected_result_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Affected Result Ids",
      "type": "array"
    },
    "reopen_condition_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Reopen Condition Ids",
      "type": "array"
    }
  },
  "required": [
    "blocker_id",
    "run_id",
    "code",
    "severity",
    "description"
  ],
  "title": "ResearchBlocker",
  "type": "object"
}
