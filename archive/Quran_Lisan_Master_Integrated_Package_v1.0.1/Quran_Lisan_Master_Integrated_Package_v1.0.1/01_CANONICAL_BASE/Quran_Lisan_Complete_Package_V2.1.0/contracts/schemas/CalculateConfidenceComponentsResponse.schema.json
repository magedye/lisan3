{
  "$defs": {
    "ConfidenceBand": {
      "enum": [
        "NOT_EVALUATED",
        "WEAK",
        "TENTATIVE",
        "SUPPORTED",
        "STRONG"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "ConfidenceComponent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Record Revision",
          "type": "integer"
        },
        "supersedes_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Id"
        },
        "component_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "title": "Component Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "band": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "evaluated": {
          "title": "Evaluated",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        },
        "calibration_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Version"
        }
      },
      "required": [
        "component_id",
        "name",
        "band",
        "evaluated",
        "reason"
      ],
      "title": "ConfidenceComponent",
      "type": "object"
    },
    "ExecutionActor": {
      "enum": [
        "TOOL",
        "MODEL",
        "AGENT",
        "SKILL",
        "HUMAN",
        "SYSTEM"
      ],
      "title": "ExecutionActor",
      "type": "string"
    },
    "ExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Record Revision",
          "type": "integer"
        },
        "supersedes_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Id"
        },
        "receipt_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/ExecutionActor"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actor_version": {
          "title": "Actor Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "output_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Digest"
        },
        "source_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "retry_of_receipt_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of Receipt Id"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "actor",
        "actor_id",
        "actor_version",
        "status",
        "started_at",
        "ended_at",
        "input_digest"
      ],
      "title": "ExecutionReceipt",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "NOT_EVALUATED"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/ConfidenceComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "overall_numeric": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overall Numeric"
    },
    "receipt": {
      "$ref": "#/$defs/ExecutionReceipt"
    }
  },
  "required": [
    "components",
    "receipt"
  ],
  "title": "CalculateConfidenceComponentsResponse",
  "type": "object"
}
