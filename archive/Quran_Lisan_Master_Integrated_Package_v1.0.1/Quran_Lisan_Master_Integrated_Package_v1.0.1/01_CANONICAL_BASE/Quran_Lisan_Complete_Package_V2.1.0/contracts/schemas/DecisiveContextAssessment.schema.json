{
  "$defs": {
    "DecisiveContextEffect": {
      "enum": [
        "SUPPORT",
        "NARROW",
        "OPPOSE",
        "FALSIFY",
        "MIXED"
      ],
      "title": "DecisiveContextEffect",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "assessment_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "occurrence_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Occurrence Id",
      "type": "string"
    },
    "tested_hypothesis_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Tested Hypothesis Ids",
      "type": "array"
    },
    "effect": {
      "$ref": "#/$defs/DecisiveContextEffect"
    },
    "evidence_relation_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Evidence Relation Ids",
      "type": "array"
    },
    "structural_sensitivity": {
      "title": "Structural Sensitivity",
      "type": "string"
    },
    "outcome_brief": {
      "title": "Outcome Brief",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "run_id",
    "occurrence_id",
    "tested_hypothesis_ids",
    "effect",
    "structural_sensitivity",
    "outcome_brief"
  ],
  "title": "DecisiveContextAssessment",
  "type": "object"
}
