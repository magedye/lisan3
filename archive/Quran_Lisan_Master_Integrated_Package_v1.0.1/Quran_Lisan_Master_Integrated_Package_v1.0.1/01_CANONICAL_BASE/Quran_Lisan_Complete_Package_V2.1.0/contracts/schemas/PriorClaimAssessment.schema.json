{
  "$defs": {
    "PriorClaimDisposition": {
      "enum": [
        "SUPPORTED_BY_CURRENT_METHOD",
        "SUPPORTED_WITH_REFINEMENT",
        "PARTIALLY_SUPPORTED",
        "INSUFFICIENT_EVIDENCE",
        "CONTEXT_LEAKAGE",
        "FORM_ROOT_CONFLATION",
        "HERITAGE_PRIOR_CONTAMINATION",
        "OVERGENERALIZED",
        "FALSIFIED",
        "UNRESOLVED"
      ],
      "title": "PriorClaimDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "assessment_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "original_claim": {
      "title": "Original Claim",
      "type": "string"
    },
    "origin_source_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Origin Source Id",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/PriorClaimDisposition"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "evidence_relation_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Evidence Relation Ids",
      "type": "array"
    },
    "retained_for_audit": {
      "default": true,
      "title": "Retained For Audit",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "run_id",
    "original_claim",
    "origin_source_id",
    "disposition",
    "rationale"
  ],
  "title": "PriorClaimAssessment",
  "type": "object"
}
