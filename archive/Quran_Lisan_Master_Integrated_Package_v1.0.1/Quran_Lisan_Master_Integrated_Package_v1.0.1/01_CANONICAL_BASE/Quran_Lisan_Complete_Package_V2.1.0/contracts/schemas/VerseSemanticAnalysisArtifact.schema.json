{
  "$defs": {
    "ArtifactType": {
      "enum": [
        "ROOT_RESEARCH",
        "TERM_RESEARCH",
        "VERSE_ANALYSIS",
        "ROOT_CARD",
        "TERM_CARD"
      ],
      "title": "ArtifactType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "artifact_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "$ref": "#/$defs/ArtifactType",
      "default": "VERSE_ANALYSIS"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "verse_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Verse Id",
      "type": "string"
    },
    "target_term_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Target Term Ids",
      "type": "array"
    },
    "term_artifact_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Term Artifact Ids",
      "type": "array"
    },
    "aggregate_meaning": {
      "title": "Aggregate Meaning",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "evidence_relation_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Evidence Relation Ids",
      "type": "array"
    },
    "unresolved_items": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Items",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "run_id",
    "verse_id",
    "aggregate_meaning",
    "scope"
  ],
  "title": "VerseSemanticAnalysisArtifact",
  "type": "object"
}
