{
  "$defs": {
    "ResearchPhase": {
      "enum": [
        "INTERNAL_ANALYSIS",
        "EXTERNAL_COMPARISON"
      ],
      "title": "ResearchPhase",
      "type": "string"
    },
    "SourceAccessOutcome": {
      "enum": [
        "ALLOWED",
        "DENIED",
        "NOT_EVALUATED"
      ],
      "title": "SourceAccessOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Event Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/ResearchPhase"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/SourceAccessOutcome"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "receipt_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Id"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "phase",
    "source_id",
    "outcome",
    "reason"
  ],
  "title": "SourceAccessEvent",
  "type": "object"
}
