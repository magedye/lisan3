{
  "$defs": {
    "ConfidenceBand": {
      "enum": [
        "NOT_EVALUATED",
        "WEAK",
        "TENTATIVE",
        "SUPPORTED",
        "STRONG"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "ConfidenceComponent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Record Revision",
          "type": "integer"
        },
        "supersedes_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Id"
        },
        "component_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "title": "Component Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "band": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "evaluated": {
          "title": "Evaluated",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        },
        "calibration_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Version"
        }
      },
      "required": [
        "component_id",
        "name",
        "band",
        "evaluated",
        "reason"
      ],
      "title": "ConfidenceComponent",
      "type": "object"
    },
    "DecisionAuthorityLevel": {
      "enum": [
        "RESEARCH_JUDGMENT"
      ],
      "title": "DecisionAuthorityLevel",
      "type": "string"
    },
    "DecisionDisposition": {
      "enum": [
        "PREFERRED",
        "UNRESOLVED",
        "REJECTED",
        "NO_DIFFERENCE_ESTABLISHED"
      ],
      "title": "DecisionDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Decision Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "authority_level": {
      "$ref": "#/$defs/DecisionAuthorityLevel",
      "default": "RESEARCH_JUDGMENT"
    },
    "disposition": {
      "$ref": "#/$defs/DecisionDisposition"
    },
    "analysis_unit": {
      "title": "Analysis Unit",
      "type": "string"
    },
    "preferred_hypothesis_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Hypothesis Id"
    },
    "competing_hypothesis_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Competing Hypothesis Ids",
      "type": "array"
    },
    "evidence_relation_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Evidence Relation Ids",
      "type": "array"
    },
    "layer_attribution_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Layer Attribution Ids",
      "type": "array"
    },
    "falsification_run_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Falsification Run Ids",
      "type": "array"
    },
    "neighbor_result_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Neighbor Result Ids",
      "type": "array"
    },
    "semantic_boundary_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Boundary Id"
    },
    "derivation_chain_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Derivation Chain Ids",
      "type": "array"
    },
    "decisive_context_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Decisive Context Ids",
      "type": "array"
    },
    "blocker_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Blocker Ids",
      "type": "array"
    },
    "completeness_profile_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Completeness Profile Id",
      "type": "string"
    },
    "confidence_components": {
      "items": {
        "$ref": "#/$defs/ConfidenceComponent"
      },
      "title": "Confidence Components",
      "type": "array"
    },
    "concise_reason": {
      "title": "Concise Reason",
      "type": "string"
    },
    "unresolved_items": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Items",
      "type": "array"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "disposition",
    "analysis_unit",
    "completeness_profile_id",
    "concise_reason"
  ],
  "title": "SemanticDecision",
  "type": "object"
}
