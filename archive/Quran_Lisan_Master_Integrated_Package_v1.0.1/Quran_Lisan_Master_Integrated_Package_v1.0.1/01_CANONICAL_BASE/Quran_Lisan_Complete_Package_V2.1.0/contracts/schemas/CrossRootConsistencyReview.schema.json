{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "review_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Review Id",
      "type": "string"
    },
    "run_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "minItems": 2,
      "title": "Run Ids",
      "type": "array"
    },
    "checked_dimensions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Checked Dimensions",
      "type": "array"
    },
    "inconsistencies": {
      "items": {
        "type": "string"
      },
      "title": "Inconsistencies",
      "type": "array"
    },
    "resolutions": {
      "items": {
        "type": "string"
      },
      "title": "Resolutions",
      "type": "array"
    },
    "unresolved_items": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Items",
      "type": "array"
    }
  },
  "required": [
    "review_id",
    "run_ids",
    "checked_dimensions"
  ],
  "title": "CrossRootConsistencyReview",
  "type": "object"
}
