{
  "$defs": {
    "AuthorizationDecision": {
      "enum": [
        "APPROVE",
        "REVISE",
        "REJECT",
        "DEFER"
      ],
      "title": "AuthorizationDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "authorization_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Authorization Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "research_decision_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Research Decision Id",
      "type": "string"
    },
    "reviewer_actor_id": {
      "title": "Reviewer Actor Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/AuthorizationDecision"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "rationale_brief": {
      "title": "Rationale Brief",
      "type": "string"
    },
    "evidence_reviewed_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Evidence Reviewed Ids",
      "type": "array"
    },
    "verification_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Verification Ids",
      "type": "array"
    },
    "supersedes_authorization_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Authorization Id"
    }
  },
  "required": [
    "authorization_id",
    "run_id",
    "research_decision_id",
    "reviewer_actor_id",
    "decision",
    "decided_at",
    "rationale_brief"
  ],
  "title": "CanonicalAuthorization",
  "type": "object"
}
