{
  "$defs": {
    "ArtifactType": {
      "enum": [
        "ROOT_RESEARCH",
        "TERM_RESEARCH",
        "VERSE_ANALYSIS",
        "ROOT_CARD",
        "TERM_CARD"
      ],
      "title": "ArtifactType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "artifact_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "$ref": "#/$defs/ArtifactType",
      "default": "ROOT_CARD"
    },
    "source_root_artifact_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Source Root Artifact Id",
      "type": "string"
    },
    "root_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Root Id",
      "type": "string"
    },
    "concise_root_concept": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Concise Root Concept"
    },
    "boundary_summary": {
      "items": {
        "type": "string"
      },
      "title": "Boundary Summary",
      "type": "array"
    },
    "decisive_evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Decisive Evidence Ids",
      "type": "array"
    },
    "neighbor_result_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Neighbor Result Ids",
      "type": "array"
    },
    "falsification_summary": {
      "title": "Falsification Summary",
      "type": "string"
    },
    "traceability_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Traceability Refs",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "source_root_artifact_id",
    "root_id",
    "falsification_summary"
  ],
  "title": "RootCard",
  "type": "object"
}
