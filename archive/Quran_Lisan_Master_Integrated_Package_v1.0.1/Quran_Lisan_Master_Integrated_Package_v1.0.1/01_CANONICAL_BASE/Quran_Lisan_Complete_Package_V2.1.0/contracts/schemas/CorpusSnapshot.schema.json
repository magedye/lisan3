{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "snapshot_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "text_profile_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Text Profile Id",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "verse_count": {
      "exclusiveMinimum": 0,
      "title": "Verse Count",
      "type": "integer"
    },
    "encoding": {
      "default": "UTF-8",
      "title": "Encoding",
      "type": "string"
    },
    "newline": {
      "default": "LF",
      "title": "Newline",
      "type": "string"
    },
    "normalization": {
      "default": "NONE",
      "title": "Normalization",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "source_id",
    "text_profile_id",
    "sha256",
    "size_bytes",
    "verse_count"
  ],
  "title": "CorpusSnapshot",
  "type": "object"
}
