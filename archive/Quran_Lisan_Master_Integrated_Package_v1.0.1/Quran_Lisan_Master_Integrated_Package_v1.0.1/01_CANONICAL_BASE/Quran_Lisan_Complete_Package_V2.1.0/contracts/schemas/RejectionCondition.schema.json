{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "rejection_condition_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Rejection Condition Id",
      "type": "string"
    },
    "hypothesis_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Hypothesis Id",
      "type": "string"
    },
    "operational_test": {
      "title": "Operational Test",
      "type": "string"
    },
    "failure_effect": {
      "title": "Failure Effect",
      "type": "string"
    }
  },
  "required": [
    "rejection_condition_id",
    "hypothesis_id",
    "operational_test",
    "failure_effect"
  ],
  "title": "RejectionCondition",
  "type": "object"
}
