{
  "$defs": {
    "InterpretationLayer": {
      "enum": [
        "ROOT_CONTRIBUTION",
        "LEXICAL_UNIT",
        "INFLECTION_DERIVATION",
        "MORPHOLOGICAL_FORM",
        "CONSTRUCTION",
        "SEMANTIC_ROLE",
        "CONTEXT",
        "LOCAL_MEANING",
        "DISCOURSE",
        "UNRESOLVED"
      ],
      "title": "InterpretationLayer",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "attribution_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Attribution Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "claim_fragment": {
      "title": "Claim Fragment",
      "type": "string"
    },
    "layer": {
      "$ref": "#/$defs/InterpretationLayer"
    },
    "evidence_relation_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Evidence Relation Ids",
      "type": "array"
    },
    "rationale_brief": {
      "title": "Rationale Brief",
      "type": "string"
    }
  },
  "required": [
    "attribution_id",
    "run_id",
    "claim_fragment",
    "layer",
    "rationale_brief"
  ],
  "title": "LayerAttribution",
  "type": "object"
}
