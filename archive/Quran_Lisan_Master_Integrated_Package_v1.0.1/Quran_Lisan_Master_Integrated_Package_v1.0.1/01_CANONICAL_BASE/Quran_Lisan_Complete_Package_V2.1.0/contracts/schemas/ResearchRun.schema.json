{
  "$defs": {
    "ResearchPhase": {
      "enum": [
        "INTERNAL_ANALYSIS",
        "EXTERNAL_COMPARISON"
      ],
      "title": "ResearchPhase",
      "type": "string"
    },
    "ResearchStage": {
      "enum": [
        "CREATED",
        "ANALYSIS_UNIT_RESOLVED",
        "INTERNAL_DATA_READY",
        "OBSERVATIONS_READY",
        "HYPOTHESES_READY",
        "FALSIFICATION_COMPLETED",
        "JUDGMENT_READY",
        "INTERNAL_RESULT_CLOSED",
        "INDEPENDENT_VERIFIED",
        "EXTERNAL_COMPARED",
        "PRESENTED",
        "FAILED"
      ],
      "title": "ResearchStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "methodology_version": {
      "title": "Methodology Version",
      "type": "string"
    },
    "terminology_version": {
      "title": "Terminology Version",
      "type": "string"
    },
    "text_snapshot_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Text Snapshot Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/ResearchStage",
      "default": "CREATED"
    },
    "phase": {
      "$ref": "#/$defs/ResearchPhase",
      "default": "INTERNAL_ANALYSIS"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "primary_analysis_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Analysis Unit"
    },
    "execution_receipt_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Execution Receipt Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "methodology_version",
    "terminology_version",
    "text_snapshot_id",
    "created_at",
    "updated_at"
  ],
  "title": "ResearchRun",
  "type": "object"
}
