{
  "$defs": {
    "ConfidenceBand": {
      "enum": [
        "NOT_EVALUATED",
        "WEAK",
        "TENTATIVE",
        "SUPPORTED",
        "STRONG"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "component_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Component Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "band": {
      "$ref": "#/$defs/ConfidenceBand"
    },
    "evaluated": {
      "title": "Evaluated",
      "type": "boolean"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "numeric_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Numeric Value"
    },
    "calibration_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Version"
    }
  },
  "required": [
    "component_id",
    "name",
    "band",
    "evaluated",
    "reason"
  ],
  "title": "ConfidenceComponent",
  "type": "object"
}
