{
  "$defs": {
    "CompletenessDimension": {
      "enum": [
        "OCCURRENCE_COVERAGE",
        "DERIVATIONAL_COVERAGE",
        "FORM_COVERAGE",
        "CONSTRUCTION_COVERAGE",
        "CONTEXT_DIVERSITY",
        "NEIGHBOR_COVERAGE",
        "HARD_CASE_COVERAGE",
        "FALSIFICATION_COVERAGE",
        "SOURCE_INTEGRITY",
        "DECISIVE_CONTEXT_COVERAGE",
        "DERIVATION_CHAIN_COVERAGE"
      ],
      "title": "CompletenessDimension",
      "type": "string"
    },
    "CompletenessDimensionStatus": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Record Revision",
          "type": "integer"
        },
        "supersedes_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Id"
        },
        "dimension": {
          "$ref": "#/$defs/CompletenessDimension"
        },
        "expected_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Count"
        },
        "examined_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Examined Count"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "gap_notes": {
          "items": {
            "type": "string"
          },
          "title": "Gap Notes",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "status"
      ],
      "title": "CompletenessDimensionStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "completeness_profile_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Completeness Profile Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/CompletenessDimensionStatus"
      },
      "minItems": 1,
      "title": "Dimensions",
      "type": "array"
    },
    "unresolved_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Gaps",
      "type": "array"
    }
  },
  "required": [
    "completeness_profile_id",
    "run_id",
    "dimensions"
  ],
  "title": "CompletenessProfile",
  "type": "object"
}
