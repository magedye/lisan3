{
  "$defs": {
    "IndependenceClass": {
      "enum": [
        "NONE",
        "CONTEXT_SEPARATED",
        "TOOL_VERIFIED",
        "SESSION_SEPARATED",
        "MODEL_SEPARATED",
        "HUMAN_INDEPENDENT"
      ],
      "title": "IndependenceClass",
      "type": "string"
    },
    "VerificationKind": {
      "enum": [
        "DETERMINISTIC",
        "ADVERSARIAL",
        "BLIND",
        "CROSS_MODEL",
        "HUMAN_REVIEW",
        "MOA_DEEP_REVIEW"
      ],
      "title": "VerificationKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "verification_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Verification Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/VerificationKind"
    },
    "independence_class": {
      "$ref": "#/$defs/IndependenceClass"
    },
    "prior_result_visible": {
      "title": "Prior Result Visible",
      "type": "boolean"
    },
    "finding": {
      "title": "Finding",
      "type": "string"
    },
    "evidence_relation_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Evidence Relation Ids",
      "type": "array"
    },
    "receipt_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
        "type": "string"
      },
      "title": "Receipt Ids",
      "type": "array"
    }
  },
  "required": [
    "verification_id",
    "run_id",
    "kind",
    "independence_class",
    "prior_result_visible",
    "finding"
  ],
  "title": "IndependentVerification",
  "type": "object"
}
