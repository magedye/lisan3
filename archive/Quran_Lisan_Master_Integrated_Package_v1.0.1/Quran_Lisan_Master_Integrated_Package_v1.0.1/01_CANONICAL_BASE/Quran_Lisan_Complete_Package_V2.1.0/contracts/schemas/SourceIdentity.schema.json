{
  "$defs": {
    "ResearchPhase": {
      "enum": [
        "INTERNAL_ANALYSIS",
        "EXTERNAL_COMPARISON"
      ],
      "title": "ResearchPhase",
      "type": "string"
    },
    "SourceClass": {
      "enum": [
        "QURAN_TEXT",
        "STRUCTURAL",
        "EXTERNAL_TRADITION",
        "EXTERNAL_LINGUISTIC",
        "EXPERIMENTAL_DATASET",
        "MODEL_MEMORY",
        "PRIOR_RESULT"
      ],
      "title": "SourceClass",
      "type": "string"
    },
    "SourceRole": {
      "enum": [
        "CANONICAL_TEXT",
        "STRUCTURAL_EVIDENCE",
        "STRUCTURAL_FIXTURE_ONLY",
        "HYPOTHESIS_ONLY",
        "EXTERNAL_COMPARISON",
        "EVALUATION_ONLY",
        "PROHIBITED_INTERNAL"
      ],
      "title": "SourceRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "record_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Record Revision",
      "type": "integer"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "source_class": {
      "$ref": "#/$defs/SourceClass"
    },
    "source_role": {
      "$ref": "#/$defs/SourceRole"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uri"
    },
    "allowed_phases": {
      "items": {
        "$ref": "#/$defs/ResearchPhase"
      },
      "title": "Allowed Phases",
      "type": "array"
    },
    "allowed_fields": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Fields",
      "type": "array"
    },
    "forbidden_fields": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Fields",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "name",
    "source_class",
    "source_role",
    "version"
  ],
  "title": "SourceIdentity",
  "type": "object"
}
