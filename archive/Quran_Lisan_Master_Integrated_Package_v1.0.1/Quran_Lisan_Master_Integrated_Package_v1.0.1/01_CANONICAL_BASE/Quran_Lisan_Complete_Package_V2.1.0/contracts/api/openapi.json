  "components": {
    "schemas": {
      "ApplySourcePolicyRequest": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "phase": {
            "$ref": "#/components/schemas/ResearchPhase"
          },
          "requested_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Requested Fields"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "phase"
        ],
        "title": "ApplySourcePolicyRequest"
      },
      "ApplySourcePolicyResponse": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/SourceAccessOutcome"
          },
          "allowed_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Fields"
          },
          "denied_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Denied Fields"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "receipt": {
            "$ref": "#/components/schemas/ExecutionReceipt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "allowed_fields",
          "denied_fields",
          "reason",
          "receipt"
        ],
        "title": "ApplySourcePolicyResponse"
      },
      "CalculateCompletenessRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "CalculateCompletenessRequest"
      },
      "CalculateCompletenessResponse": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/CompletenessProfile"
          },
          "receipt": {
            "$ref": "#/components/schemas/ExecutionReceipt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile",
          "receipt"
        ],
        "title": "CalculateCompletenessResponse"
      },
      "CalculateConfidenceComponentsRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "calibration_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calibration Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "CalculateConfidenceComponentsRequest"
      },
      "CalculateConfidenceComponentsResponse": {
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/ConfidenceComponent"
            },
            "type": "array",
            "title": "Components"
          },
          "overall_numeric": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overall Numeric"
          },
          "receipt": {
            "$ref": "#/components/schemas/ExecutionReceipt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "components",
          "receipt"
        ],
        "title": "CalculateConfidenceComponentsResponse"
      },
      "CompletenessDimension": {
        "type": "string",
        "enum": [
          "OCCURRENCE_COVERAGE",
          "DERIVATIONAL_COVERAGE",
          "FORM_COVERAGE",
          "CONSTRUCTION_COVERAGE",
          "CONTEXT_DIVERSITY",
          "NEIGHBOR_COVERAGE",
          "HARD_CASE_COVERAGE",
          "FALSIFICATION_COVERAGE",
          "SOURCE_INTEGRITY",
          "DECISIVE_CONTEXT_COVERAGE",
          "DERIVATION_CHAIN_COVERAGE"
        ],
        "title": "CompletenessDimension"
      },
      "CompletenessDimensionStatus": {
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Schema Version",
            "default": "2.1.0"
          },
          "record_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Record Revision",
            "default": 1
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 3,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "dimension": {
            "$ref": "#/components/schemas/CompletenessDimension"
          },
          "expected_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Count"
          },
          "examined_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Examined Count"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "gap_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gap Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dimension",
          "status"
        ],
        "title": "CompletenessDimensionStatus"
      },
      "CompletenessProfile": {
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Schema Version",
            "default": "2.1.0"
          },
          "record_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Record Revision",
            "default": 1
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 3,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "completeness_profile_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
            "title": "Completeness Profile Id"
          },
          "run_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
            "title": "Run Id"
          },
          "dimensions": {
            "items": {
              "$ref": "#/components/schemas/CompletenessDimensionStatus"
            },
            "type": "array",
            "minItems": 1,
            "title": "Dimensions"
          },
          "unresolved_gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unresolved Gaps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "completeness_profile_id",
          "run_id",
          "dimensions"
        ],
        "title": "CompletenessProfile"
      },
      "ConfidenceBand": {
        "type": "string",
        "enum": [
          "NOT_EVALUATED",
          "WEAK",
          "TENTATIVE",
          "SUPPORTED",
          "STRONG"
        ],
        "title": "ConfidenceBand"
      },
      "ConfidenceComponent": {
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Schema Version",
            "default": "2.1.0"
          },
          "record_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Record Revision",
            "default": 1
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 3,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "component_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
            "title": "Component Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "band": {
            "$ref": "#/components/schemas/ConfidenceBand"
          },
          "evaluated": {
            "type": "boolean",
            "title": "Evaluated"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "numeric_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Numeric Value"
          },
          "calibration_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calibration Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "component_id",
          "name",
          "band",
          "evaluated",
          "reason"
        ],
        "title": "ConfidenceComponent"
      },
      "ExecutionActor": {
        "type": "string",
        "enum": [
          "TOOL",
          "MODEL",
          "AGENT",
          "SKILL",
          "HUMAN",
          "SYSTEM"
        ],
        "title": "ExecutionActor"
      },
      "ExecutionReceipt": {
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Schema Version",
            "default": "2.1.0"
          },
          "record_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Record Revision",
            "default": 1
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 3,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "receipt_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
            "title": "Receipt Id"
          },
          "run_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$",
            "title": "Run Id"
          },
          "actor": {
            "$ref": "#/components/schemas/ExecutionActor"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "actor_version": {
            "type": "string",
            "title": "Actor Version"
          },
          "status": {
            "$ref": "#/components/schemas/ExecutionStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ended At"
          },
          "input_digest": {
            "type": "string",
            "title": "Input Digest"
          },
          "output_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Digest"
          },
          "source_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:\\-]{2,127}$"
            },
            "type": "array",
            "title": "Source Ids"
          },
          "tool_call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Call Id"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
