
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lisan.local/schemas/semantic-family-relation-map-v1.1-candidate.schema.json",
  "title": "Semantic Family Relation Map v1.1-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "family_id", "target", "claim_scope",
    "discovery_search_method", "candidate_neighbors_considered", "family_completion_claimed",
    "family_completion_scope", "unresolved_assignments", "evidence_refs", "dependency_refs",
    "owner_accepted", "release_accepted"
  ],
  "properties": {
    "schema_version": {"const": "1.1-candidate"},
    "artifact_type": {"const": "SEMANTIC_FAMILY_RELATION_MAP"},
    "family_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "claim_scope": {"type": "string", "minLength": 1},
    "discovery_search_method": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "candidate_neighbors_considered": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "family_completion_claimed": {"type": "boolean"},
    "family_completion_scope": {"type": "string", "minLength": 1},
    "unresolved_assignments": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "dependency_refs": {"type": "array", "items": {"type": "string"}},
    "owner_accepted": {"const": false},
    "release_accepted": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"family_completion_claimed": {"const": true}}},
      "then": {
        "properties": {
          "discovery_search_method": {"minItems": 1},
          "candidate_neighbors_considered": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["neighbor", "decision", "rationale", "relation_type", "essentiality", "comparison_level", "threatened_claims", "coverage_status"],
      "properties": {
        "neighbor": {"type": "string", "minLength": 1},
        "decision": {"enum": ["INCLUDED", "EXCLUDED", "UNRESOLVED"]},
        "rationale": {"type": "string", "minLength": 1},
        "relation_type": {"enum": ["OVERLAP", "CONTRAST", "SUBSET_CANDIDATE", "CONTEXTUAL_CONVERGENCE", "UNRESOLVED"]},
        "essentiality": {"enum": ["ESSENTIAL", "SUPPORTING", "EXPLORATORY"]},
        "comparison_level": {"enum": ["ROOT", "LEXEME", "FORM", "CONSTRUCTION", "LOCAL_MEANING"]},
        "threatened_claims": {"type": "array", "items": {"type": "string"}},
        "coverage_status": {"type": "string", "minLength": 1}
      }
    }
  }
}

