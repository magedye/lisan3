{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Family Relation Map v1",
  "type": "object",
  "required": [
    "schema_version",
    "family_id",
    "target_root",
    "members",
    "shared_core",
    "relationships",
    "distinctive_residue",
    "convergence_instances",
    "divergence_instances",
    "substitution_tests",
    "falsification_tests",
    "semantic_boundaries",
    "exclusions",
    "dependencies",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "target_root": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "array",
      "minItems": 2
    },
    "relationships": {
      "type": "array",
      "minItems": 1
    },
    "substitution_tests": {
      "type": "array",
      "minItems": 1
    },
    "falsification_tests": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
