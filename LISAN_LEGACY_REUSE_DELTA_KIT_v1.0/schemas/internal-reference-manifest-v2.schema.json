{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal Reference Manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "freeze_artifact_ref",
    "freeze_sha256",
    "reference_open_stage",
    "references",
    "influence_log"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "freeze_artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "freeze_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "reference_open_stage": {
      "const": "AFTER_INITIAL_HYPOTHESIS_FREEZE"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference_id",
          "eligibility_tier",
          "source_claim_id",
          "claim_scope",
          "permitted_use",
          "forbidden_use",
          "reason_for_use"
        ],
        "properties": {
          "forbidden_use": {
            "type": "array",
            "contains": {
              "const": "TEXTUAL_EVIDENCE"
            }
          },
          "permitted_use": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "influence_log": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
