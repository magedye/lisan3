# Python virtualenv and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.mypy_cache/
.schemathesis/

# Local SQLite runtime/test databases (not part of source history)
*.db
*.db-shm
*.db-wal
*.sqlite

# Frontend dependencies and build outputs (also covered by frontend/.gitignore)
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
playwright-report/
test-results/

# IDE / OS local state
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets / local environment overrides
.env
.env.*
!.env.example

# Logs and transient output
*.log

# Master Integrated Package v1.0.1 — retained locally as a hash-bound reference
# archive (see docs/canonical/ADMISSION_MASTER_PACKAGE_V1_0_1.md), not source.
/Quran_Lisan_Master_Integrated_Package_v1.0.1.zip
/Quran_Lisan_Master_Integrated_Package_v1.0.1/

# QAC morphology (GNU GPL, © 2011 Kais Dukes) — admitted as a LOCAL, hash-bound,
# acquire-per-install immutable source (see docs/canonical/ADMISSION_QAC.md). The
# raw GPL artifact is not redistributed via this repo; each install acquires its
# own byte-identical copy (SHA-256 a1d12923...). Derived annotations are runtime.
/data/corpus/qac/*.txt

# Campaign runtime: local DB + per-root occurrence packets (QAC-derived + Tanzil
# text). Durable campaign records are committed under artifacts/semantic-campaign/.
/data/campaign/
